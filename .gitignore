# Keep only native application source, build inputs and documentation.
/*
!/.gitignore
!/LICENSE
!/README.md

# Only include curated README screenshots, not local design or test output.
!/docs/
/docs/*
!/docs/screenshots/
/docs/screenshots/*
!/docs/screenshots/*.webp

!/rust-app/
!/tools/
/tools/*
!/tools/build-rust-win.ps1

# Generated native binaries and debug symbols.
/rust-app/target/
/rust-app/**/*.pdb

# User databases, release artifacts, caches and local reference documents
# remain local (data/, dist/, .test-output/, etc. are excluded above).
