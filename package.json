{
  "name": "board_cut_optimizer",
  "version": "1.0.22",
  "description": "板优排——Windows 本地板材开料优化与报价应用",
  "private": true,
  "type": "module",
  "main": "electron-main.mjs",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "desktop": "electron .",
    "build:win": "electron-builder --win --x64",
    "test": "node tests/run.mjs"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "cn.banyoupai.board-cut-optimizer",
    "productName": "板优排",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.mjs",
      "engine.mjs",
      "optimization-worker.mjs",
      "optimization-client.mjs",
      "beam-nesting.mjs",
      "parts-csv.mjs",
      "tax-pricing.mjs",
      "logistics.mjs",
      "quotation.mjs",
      "storage.mjs",
      "server.mjs",
      "electron-main.mjs",
      "electron-zoom.mjs",
      "assets/app-icon.png",
      "package.json"
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        "zip"
      ],
      "artifactName": "board_cut_optimizer-portable-${version}-${arch}.${ext}"
    }
  }
}
